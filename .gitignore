# Generated verification screenshots from the render smoke test.
.synthnet-shots/

# The standalone single-file build. Generated by tools/build.py, and published
# by CI as an artifact -- committing ~700 KB on every content change would
# bloat history permanently for a file that is reproducible in one command.
synthnet/dist/

__pycache__/
*.pyc

# Android build output. The APK is generated by synthnet/android/build.sh and
# published by CI as an artifact; the debug keystore is a signing key and must
# never be committed, even though it only signs for sideloading.
synthnet/android/build/
synthnet/android/*.apk
synthnet/android/*.apk.idsig
synthnet/android/*.keystore
