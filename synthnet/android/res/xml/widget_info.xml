<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis has a hard floor of 30 minutes: anything smaller is
     silently clamped, so asking for less is not an optimisation, it is a
     misunderstanding. Under Doze the update is an inexact alarm and gets
     deferred to a maintenance window anyway, which is fine, because nothing
     here needs to be accurate to the minute.

     Note what is absent from this file and from the manifest entry that
     points at it: any permission at all. A widget needs none, is
     re-registered after a reboot by the system, and cannot be declined. That
     is why it is the half of "tell me when things happen" that keeps working
     when an OEM battery manager throttles the alarm. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget"
    android:previewLayout="@layout/widget"
    android:description="@string/widget_desc"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
