<?xml version="1.0" encoding="utf-8"?>
<!-- The widget. Deliberately two pieces of information and nothing else:
     a number, and one line saying what it is. A widget that needs reading
     twice is a widget nobody looks at.

     RemoteViews supports a small set of layouts and no custom views, so this
     is LinearLayout and TextViews, which is all it needs to be. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VERITYNET"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:textColor="#BBD6EC" />

    <TextView
        android:id="@+id/widget_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="—"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/widget_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Open Synthnet once and this fills in."
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#DCEAF6" />

</LinearLayout>
