<?xml version="1.0" encoding="utf-8"?>
<!-- The same Aero blue the browser chrome uses, so the widget reads as part
     of the same object rather than as a second app. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="#2E6DA4"
        android:endColor="#1C4F7C"
        android:angle="270" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="#15405F" />
</shape>
